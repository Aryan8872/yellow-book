import 'package:dartz/dartz.dart';
import 'package:entertainer/core/error/failures.dart';
import 'package:entertainer/features/auth/data/services/google_auth_service.dart';
import 'package:entertainer/features/auth/data/datasource/auth_remote_datasource.dart';

class GoogleAuthUsecase {
  final GoogleAuthService _googleAuthService;
  final AuthRemoteDataSource _authRemoteDataSource;

  GoogleAuthUsecase(
    this._googleAuthService,
    this._authRemoteDataSource,
  );

  Future<Either<Failure, Map<String, dynamic>>> call() async {
    try {
      // Sign in with Google
      final account = await _googleAuthService.signIn();
      if (account == null) {
        return Left(ValidationFailure('Google sign-in was cancelled'));
      }

      // Get ID token
      final idToken = await _googleAuthService.getIdToken();
      if (idToken == null) {
        return Left(ValidationFailure('Failed to get Google ID token'));
      }

      // Send ID token to backend
      final response = await _authRemoteDataSource.googleLogin(idToken);

      return Right(response);
    } catch (e) {
      return Left(ServerFailure(e.toString()));
    }
  }
}
